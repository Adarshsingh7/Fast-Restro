# Copy this file to config.env and fill in your own values.
NODE_ENV=development
PORT=3000

# MongoDB connection string
DATABASE_REMOTE=mongodb://127.0.0.1:27017/react-quick-restro

# JWT auth — use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
JWT_EXPIRE=90d
JWT_COOKIE_EXPIRES_IN=90

# Email (optional; order and password emails are skipped without it)
EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Razorpay — the server will not start if the key id is empty.
# Use a placeholder while developing without payments.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder

# Cloudinary (optional; profile and menu images are stored locally instead)
CLOUDINARY_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# Pusher (optional; live updates use Socket.IO instead)
PUSHER_APP_ID=placeholder
PUSHER_KEY=placeholder
PUSHER_SECRET=placeholder
